# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in.  NEVER commit a filled-in copy.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase: project settings --------------------------------------------
# Both of these are safe to expose to the browser (the anon key is protected
# by Row Level Security, NOT by being secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase: SERVER ONLY -------------------------------------------------
# This key BYPASSES Row Level Security. It must only ever be read inside
# Route Handlers / server code.
#
# Guard rails (enforced in code):
#   * `src/lib/supabase/server.ts` throws if this is imported into a client bundle
#   * `src/lib/env.ts` validates it is set only when `serverEnv` is accessed
#   * nothing under `NEXT_PUBLIC_` may reference it
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Internal scheduler ----------------------------------------------------
# Shared secret for POST /api/internal/* (advance-phases, cleanup).
# Generate with:  openssl rand -hex 32
# Rotating it invalidates any in-flight scheduler cron immediately.
SCHEDULER_SECRET=replace-with-32-byte-random-hex

# --- Optional: direct Postgres, used by integration/RLS tests only ---------
# Needs the direct connection string (port 5432), NOT the pooler (6543).
# Without this, integration tests skip themselves instead of passing vacuously.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Tunables are NOT env vars for the MVP. They live in src/lib/game/settings.ts
# so they are versioned and unit-tested. Only deployment secrets belong here.
# ---------------------------------------------------------------------------
